{
  "name": "kashsec-academy",
  "version": "2.6.0",
  "description": "A completely free cybersecurity course, from absolute zero to job-ready.",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "build": "node generate-glossary.js && node generate-search-index.js && node generate-lesson-hashes.js && node generate-feed.js && node generate-prerender.js && node generate-sw.js",
    "build:sw": "node generate-sw.js",
    "build:glossary": "node generate-glossary.js",
    "build:search": "node generate-search-index.js",
    "build:feed": "node generate-feed.js",
    "build:prerender": "node generate-prerender.js",
    "test": "node tests/data-integrity.test.js && npm run test:smoke",
    "build:hashes": "node generate-lesson-hashes.js",
    "test:data": "node tests/data-integrity.test.js",
    "test:smoke": "node tests/smoke.spec.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iamishfaq07/KashSec.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Iamishfaq07/KashSec/issues"
  },
  "homepage": "https://github.com/Iamishfaq07/KashSec#readme",
  "dependencies": {
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^2.0.0"
  },
  "devDependencies": {
    "marked": "^18.0.6",
    "playwright": "^1.49.0"
  }
}
